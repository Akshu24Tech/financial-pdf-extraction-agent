 "_meta": {
  "created": "2026-06-11",
  "method": "Values hand-read from VISUAL page renders (pypdfium2, 4-6x zoom, two-up pages split, dense pages cropped) - independent of the PDF text layer the extractor parses. Every value was cross-checked against accounting identities at reading time (assets composition, liabilities composition, profit buildup, cash-flow buildup, closing-cash tie); identity failures forced re-zoom until resolved.",
  "value_convention": "Numbers as printed in the report's own unit (see per-file 'unit'), commas removed, Indian lakh/crore digit grouping collapsed. Negatives as printed (parens / minus).",
  "limitations": [
   "Same-model correlated-error risk: reader and extractor share model biases; mitigated by visual (not text-layer) reading + identity cross-checks, not eliminated.",
   "8 PDFs prove correctness on these 8 PDFs, not generalization.",
   "Stale the day a test PDF is replaced; re-read pages then.",
   "Variant ambiguity documented per-metric in 'note' where it exists."
  ]
 },
